{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/shop/order.schema.json",
  "title": "Order",
  "description": "An order placed in the web shop, from the cart to the delivery.",
  "type": "object",
  "required": [
    "id",
    "customer",
    "lines"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Order number.",
      "pattern": "^ORD-[0-9]{6}$",
      "examples": [
        "ORD-004211"
      ]
    },
    "status": {
      "description": "Where the order is now.",
      "enum": [
        "cart",
        "paid",
        "packed",
        "shipped",
        "delivered",
        "returned",
        "cancelled"
      ],
      "default": "cart"
    },
    "placedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer paid."
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "lines": {
      "type": "array",
      "description": "One line per product.",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "shipTo": {
      "$ref": "address.schema.json"
    },
    "coupon": {
      "type": "string",
      "minLength": 4,
      "maxLength": 20
    },
    "giftWrap": {
      "type": "boolean",
      "description": "Old gift flag."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "customer": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "billing": {
          "$ref": "address.schema.json"
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "sku",
        "qty",
        "price"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.01,
          "description": "Price of one item in EUR."
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
